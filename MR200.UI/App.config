<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="FeedVelocity" value="11" />
    <add key="MaxCuttingVelocity" value="64" />
    <add key="CoefficientOfFriction" value="0.565" />
    <add key="DepthOfCutWood" value="100" />
    <add key="TheDistanceBetweenTheCenterOfTheDiscAndTheLowestPointOfTheWood" value="75" />
    <add key="RakeAngle" value="20" />
    <add key="NumberOfTooth" value="20" />
    <add key="BladeDiameter" value="350" />
    <add key="KerfThickness" value="3.9" />
    <add key="NumberOfBlades" value="10" />

    <!-- ===================== MAINTENANCE SYSTEM ===================== -->

    <!-- Machine kinematics used to convert running time into consumed element life.
         The cutting-shaft speed is NOT listed here: it is taken from the application's
         own RPM calculation so the two can never drift apart. -->
    <add key="FeedShaftSpeedRPM" value="25" />
    <add key="VBeltLinearSpeedMeterPerSecond" value="0.371" />
    <add key="VBeltPitchLengthMillimeter" value="1200" />

    <!-- Predictive maintenance thresholds, as a percentage of expected life. -->
    <add key="PredictiveMaintenanceWarningThreshold" value="80" />
    <add key="PredictiveMaintenanceCriticalThreshold" value="95" />
    <add key="MaintenanceHistoryWindowDays" value="30" />

    <!-- Maintenance alert e-mail. Sent through the Gmail API with OAuth 2.0.
         There is NO password here and no password anywhere in this application.
         The Google OAuth client file and the refresh token live under
         %LOCALAPPDATA%\MR200 and are never committed. See GMAIL_OAUTH_SETUP.md. -->
    <add key="MaintenanceEmailEnabled" value="true" />
    <add key="MaintenanceEmailRecipient" value="ghayathahmad2002@gmail.com" />
    <add key="MaintenanceEmailSenderAddress" value="GhayathAlali2003@gmail.com" />
    <add key="MaintenanceEmailSenderDisplayName" value="MR200 Production Line Monitoring System" />
    <add key="MaintenanceGmailApplicationName" value="MR200 Maintenance Monitoring" />
    <!-- Optional: absolute path to the OAuth client JSON. Leave empty to use
         %LOCALAPPDATA%\MR200\credentials.json -->
    <add key="MaintenanceGmailCredentialsPath" value="" />
    <add key="MaintenanceElementImageDownloadTimeoutSeconds" value="20" />
  </appSettings>
</configuration>
